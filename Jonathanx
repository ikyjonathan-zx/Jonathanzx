<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rifky Jonathan Tambuwun | Portfolio & Profile</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        :root {
            --emerald-deep: #022c22;
            --emerald-dark: #064e3b;
            --emerald-primary: #10b981;
            --emerald-bright: #34d399;
            --emerald-glow: rgba(16, 185, 129, 0.35);
            --glass-bg: rgba(255, 255, 255, 0.10);
            --glass-bg-strong: rgba(6, 78, 59, 0.65);
            --glass-card: rgba(255, 255, 255, 0.12);
            --glass-border: rgba(255, 255, 255, 0.25);
            --text-pure: #ffffff;
            --text-soft: #ecfdf5;
            --text-muted: #a7f3d0;
            --gold-accent: #fcd34d;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #011f18 0%, #022c22 35%, #064e3b 70%, #043927 100%);
            color: var(--text-pure);
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
            line-height: 1.7;
        }

        /* Animated Background Orbs */
        .bg-orbs {
            position: fixed;
            inset: 0;
            z-index: 0;
            overflow: hidden;
            pointer-events: none;
        }

        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(85px);
            opacity: 0.45;
            animation: floatOrb 18s infinite ease-in-out alternate;
        }

        .orb-1 {
            width: 420px;
            height: 420px;
            background: #10b981;
            top: -100px;
            left: -80px;
            animation-delay: 0s;
        }

        .orb-2 {
            width: 380px;
            height: 380px;
            background: #059669;
            bottom: -90px;
            right: -60px;
            animation-delay: -5s;
        }

        .orb-3 {
            width: 300px;
            height: 300px;
            background: rgba(255, 255, 255, 0.18);
            top: 40%;
            left: 55%;
            animation-delay: -9s;
        }

        @keyframes floatOrb {
            0% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(45px, -35px) scale(1.1); }
            100% { transform: translate(-30px, 40px) scale(0.95); }
        }

        /* Navigation Bar */
        header {
            position: sticky;
            top: 16px;
            z-index: 100;
            max-width: 1120px;
            margin: 16px auto 0;
            padding: 0 16px;
        }

        .nav-glass {
            background: rgba(2, 44, 34, 0.78);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 12px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            font-size: 1.05rem;
            letter-spacing: 0.5px;
            color: var(--text-pure);
            cursor: pointer;
        }

        .brand-badge {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: linear-gradient(135deg, var(--emerald-primary), var(--emerald-dark));
            border: 1px solid rgba(255, 255, 255, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            box-shadow: 0 0 15px var(--emerald-glow);
        }

        .nav-links {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        .nav-btn {
            background: transparent;
            border: 1px solid transparent;
            color: var(--text-soft);
            padding: 8px 14px;
            border-radius: 12px;
            font-family: inherit;
            font-size: 0.88rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .nav-btn:hover {
            background: rgba(255, 255, 255, 0.12);
            color: #ffffff;
            transform: translateY(-2px);
        }

        .nav-btn.active {
            background: rgba(255, 255, 255, 0.22);
            border-color: rgba(255, 255, 255, 0.45);
            color: #ffffff;
            box-shadow: 0 4px 16px rgba(16, 185, 129, 0.3);
        }

        /* Main Container */
        main {
            position: relative;
            z-index: 10;
            max-width: 1060px;
            margin: 28px auto 60px;
            padding: 0 16px;
        }

        /* Page Sections & Page Transition Animations */
        .page-section {
            display: none;
            animation: pageFadeSlide 0.55s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }

        .page-section.active {
            display: block;
        }

        @keyframes pageFadeSlide {
            0% {
                opacity: 0;
                transform: translateY(24px) scale(0.985);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* Staggered Item Animations */
        .anim-item {
            opacity: 0;
            transform: translateY(20px);
        }

        .page-section.active .anim-item {
            animation: itemReveal 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }

        .delay-1 { animation-delay: 0.08s !important; }
        .delay-2 { animation-delay: 0.16s !important; }
        .delay-3 { animation-delay: 0.24s !important; }
        .delay-4 { animation-delay: 0.32s !important; }
        .delay-5 { animation-delay: 0.40s !important; }
        .delay-6 { animation-delay: 0.48s !important; }

        @keyframes itemReveal {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Glass Card Styling for High Readability */
        .glass-panel {
            background: rgba(4, 47, 36, 0.72);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 26px;
            padding: 36px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.2);
        }

        .glass-subcard {
            background: rgba(255, 255, 255, 0.10);
            border: 1px solid rgba(255, 255, 255, 0.22);
            border-radius: 18px;
            padding: 22px;
            transition: transform 0.3s ease, background 0.3s ease, border-color 0.3s ease;
        }

        .glass-subcard:hover {
            transform: translateY(-4px);
            background: rgba(255, 255, 255, 0.16);
            border-color: rgba(255, 255, 255, 0.42);
        }

        /* Section Titles */
        .section-header {
            margin-bottom: 28px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.18);
            padding-bottom: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
        }

        .section-title {
            font-size: 1.85rem;
            font-weight: 700;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 12px;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.25);
        }

        .section-title i {
            color: var(--emerald-bright);
            background: rgba(255, 255, 255, 0.12);
            padding: 10px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            font-size: 1.25rem;
        }

        .page-indicator {
            font-size: 0.82rem;
            font-weight: 600;
            background: rgba(255, 255, 255, 0.14);
            padding: 6px 14px;
            border-radius: 999px;
            border: 1px solid rgba(255, 255, 255, 0.25);
            color: var(--text-soft);
        }

        /* Hero / Page 1 */
        .hero-grid {
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 36px;
            align-items: center;
        }

        .profile-photo-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 14px;
        }

        .photo-ring {
            position: relative;
            width: 230px;
            height: 230px;
            border-radius: 50%;
            padding: 7px;
            background: linear-gradient(135deg, #ffffff, #34d399, #064e3b);
            box-shadow: 0 0 35px rgba(16, 185, 129, 0.45);
            animation: pulseRing 4s infinite ease-in-out;
        }

        @keyframes pulseRing {
            0%, 100% { box-shadow: 0 0 25px rgba(16, 185, 129, 0.4); }
            50% { box-shadow: 0 0 45px rgba(52, 211, 153, 0.7); }
        }

        .photo-ring img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
            background: #022c22;
            display: block;
        }

        .upload-btn {
            background: rgba(255, 255, 255, 0.16);
            hover: background: rgba(255, 255, 255, 0.26);
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.35);
            padding: 8px 16px;
            border-radius: 999px;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.25s ease;
        }

        .upload-btn:hover {
            background: rgba(255, 255, 255, 0.28);
            transform: scale(1.03);
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(16, 185, 129, 0.22);
            border: 1px solid rgba(52, 211, 153, 0.45);
            color: #ecfdf5;
            padding: 6px 14px;
            border-radius: 999px;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 14px;
        }

        .hero-name {
            font-size: 2.35rem;
            font-weight: 700;
            line-height: 1.2;
            margin-bottom: 14px;
            color: #ffffff;
            text-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
        }

        .info-pills {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 24px;
        }

        .info-pill {
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(255, 255, 255, 0.10);
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 10px 16px;
            border-radius: 14px;
            font-size: 0.96rem;
            color: #ffffff;
        }

        .info-pill i {
            color: var(--emerald-bright);
            width: 20px;
            text-align: center;
        }

        .cta-group {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #10b981, #059669);
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.35);
            padding: 12px 22px;
            border-radius: 14px;
            font-weight: 700;
            font-size: 0.95rem;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            box-shadow: 0 8px 20px rgba(16, 185, 129, 0.35);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 26px rgba(16, 185, 129, 0.5);
        }

        .btn-glass {
            background: rgba(255, 255, 255, 0.14);
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.32);
            padding: 12px 22px;
            border-radius: 14px;
            font-weight: 600;
            font-size: 0.95rem;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
        }

        .btn-glass:hover {
            background: rgba(255, 255, 255, 0.24);
            transform: translateY(-2px);
        }

        /* All About Me Typography */
        .story-paragraphs {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .story-box {
            background: rgba(255, 255, 255, 0.09);
            border-left: 4px solid var(--emerald-bright);
            border-top: 1px solid rgba(255, 255, 255, 0.16);
            border-right: 1px solid rgba(255, 255, 255, 0.16);
            border-bottom: 1px solid rgba(255, 255, 255, 0.16);
            border-radius: 0 16px 16px 0;
            padding: 20px 24px;
            font-size: 1.02rem;
            color: #ffffff;
            line-height: 1.8;
            text-align: justify;
        }

        /* Timeline (Education & Organization) */
        .timeline {
            position: relative;
            padding-left: 28px;
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .timeline::before {
            content: '';
            position: absolute;
            left: 7px;
            top: 8px;
            bottom: 8px;
            width: 3px;
            background: linear-gradient(to bottom, #34d399, rgba(255, 255, 255, 0.25));
            border-radius: 3px;
        }

        .timeline-item {
            position: relative;
            background: rgba(255, 255, 255, 0.10);
            border: 1px solid rgba(255, 255, 255, 0.22);
            border-radius: 16px;
            padding: 18px 22px;
            transition: all 0.3s ease;
        }

        .timeline-item:hover {
            background: rgba(255, 255, 255, 0.16);
            transform: translateX(6px);
        }

        .timeline-item::before {
            content: '';
            position: absolute;
            left: -26px;
            top: 22px;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: #34d399;
            border: 3px solid #022c22;
            box-shadow: 0 0 10px #34d399;
        }

        .timeline-item.current {
            background: rgba(16, 185, 129, 0.22);
            border-color: rgba(52, 211, 153, 0.55);
        }

        .badge-year {
            display: inline-block;
            background: rgba(255, 255, 255, 0.18);
            color: #ecfdf5;
            font-size: 0.8rem;
            font-weight: 700;
            padding: 4px 12px;
            border-radius: 999px;
            margin-bottom: 6px;
        }

        .timeline-title {
            font-size: 1.12rem;
            font-weight: 700;
            color: #ffffff;
        }

        .timeline-sub {
            font-size: 0.94rem;
            color: #d1fae5;
            margin-top: 4px;
        }

        /* Two Column Grid for Org & Achievements */
        .two-col {
            display: grid;
            grid-template-columns: 1.25fr 1fr;
            gap: 24px;
        }

        .sub-heading {
            font-size: 1.2rem;
            font-weight: 700;
            color: #a7f3d0;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .award-card {
            background: linear-gradient(145deg, rgba(255, 255, 255, 0.15), rgba(16, 185, 129, 0.15));
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 18px;
            padding: 20px;
            margin-bottom: 16px;
            display: flex;
            gap: 16px;
            align-items: flex-start;
            transition: transform 0.3s ease;
        }

        .award-card:hover {
            transform: translateY(-4px);
        }

        .award-icon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            background: rgba(252, 211, 77, 0.2);
            border: 1px solid rgba(252, 211, 77, 0.5);
            color: var(--gold-accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            flex-shrink: 0;
        }

        /* Skills & Talents Grid */
        .skills-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
        }

        .skill-chip-card {
            background: rgba(255, 255, 255, 0.11);
            border: 1px solid rgba(255, 255, 255, 0.24);
            border-radius: 16px;
            padding: 18px;
            display: flex;
            align-items: center;
            gap: 14px;
            font-weight: 600;
            font-size: 1rem;
            color: #ffffff;
            transition: all 0.3s ease;
        }

        .skill-chip-card:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-4px) scale(1.02);
            border-color: #34d399;
        }

        .skill-chip-card i {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: rgba(16, 185, 129, 0.28);
            color: #6ee7b7;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            flex-shrink: 0;
        }

        /* Bible Verses & Contact */
        .verse-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 28px;
        }

        .verse-card {
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 20px;
            padding: 24px;
            position: relative;
        }

        .verse-ref {
            font-family: 'Cinzel', serif;
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--gold-accent);
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .verse-text {
            font-size: 1.02rem;
            font-style: italic;
            color: #ffffff;
            line-height: 1.75;
        }

        .contact-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 18px;
        }

        .contact-link {
            text-decoration: none;
            background: rgba(255, 255, 255, 0.13);
            border: 1px solid rgba(255, 255, 255, 0.28);
      
